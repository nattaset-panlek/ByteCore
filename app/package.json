{
  "name": "bytecore",
  "productName": "ByteCore",
  "version": "1.0.0",
  "private": true,
  "description": "ByteCore / Xea OS: hacker OS simulation game",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build && electron-builder --win",
    "deploy:web": "npm run build && npx wrangler deploy"
  },
  "build": {
    "appId": "com.squadxstudio.bytecore",
    "productName": "ByteCore",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ByteCore",
      "artifactName": "ByteCore-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ByteCore-${version}-portable.${ext}"
    },
    "afterPack": "build/afterPack.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "author": "SquadX Studio"
}
